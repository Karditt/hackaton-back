{
  "name": "geoscan-planner-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Редактор сценария и визуализация плана. Слой представления: не считает маршруты, а рисует то, что вернул API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:types": "json-schema-to-typescript src/types/schema.json -o src/types/schema.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
